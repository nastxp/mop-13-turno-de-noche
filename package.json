    "deploy:prepare": "npm run build && node scripts/prepare-deploy.mjs",
    "start": "node deploy/server.js"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
