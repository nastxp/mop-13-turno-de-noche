{
  "name": "mop-13",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MOP-13 — Turno de noche en el espacio. Simulador de conserje espacial en pixel art.",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
